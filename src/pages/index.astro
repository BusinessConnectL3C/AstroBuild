---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Business Connect World — Connecting Business Expertise with Social Impact">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#1b3a6b] via-[#1e4a80] to-[#1b3a6b] text-white">
    <div class="max-w-7xl mx-auto px-8 py-16 md:py-20 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-[#8dc63f] text-xs font-bold tracking-widest uppercase mb-4">Mission Driven</p>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">
          Connecting Business Expertise with Social Impact
        </h1>
        <p class="text-blue-200 text-base leading-relaxed mb-8 max-w-lg">
          A comprehensive ecosystem of resources, including a solutions database, tailored consultations, and GIS services, to empower organizations in their missions for safe water and hygiene.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/explore/bc-for-water" class="bg-[#8dc63f] hover:bg-[#76a834] transition-colors text-white font-bold px-6 py-3 rounded text-sm">
            Explore Solutions
          </a>
          <a href="/about" class="border border-white/40 text-white hover:bg-white/10 transition-colors font-bold px-6 py-3 rounded text-sm">
            Learn More
          </a>
        </div>
      </div>
      <div class="relative">
        <div class="bg-white/10 rounded-xl overflow-hidden aspect-[4/3] flex items-center justify-center">
          <div class="text-center p-8">
            <!-- Placeholder for hero image -->
            <svg class="w-24 h-24 mx-auto text-[#8dc63f] mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-blue-200 text-sm">Business Connect for Water</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BC for Water banner -->
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-8 py-10">
      <div class="text-center mb-8">
        <h2 class="text-[#1b3a6b] font-extrabold text-2xl mb-1">
          <span class="text-[#1b6b8a]">Business Connect</span> <span class="text-[#8dc63f] italic">for Water</span>
        </h2>
        <p class="text-gray-600 text-sm max-w-xl mx-auto">A comprehensive ecosystem of resources, including a solutions database, tailored consultations, and GIS services, to empower organizations in their missions for safe water and hygiene.</p>
      </div>
      <div class="text-center mb-6">
        <p class="text-[#1b3a6b] font-semibold text-sm mb-6">Learn how Business Connect for Water can help:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {[
            { icon: '🔍', title: 'Vetted Solutions', desc: 'World-class water solutions for any application, from rural, domestic, and beyond.', link: 'Explore the database', href: '/explore/solutions-database' },
            { icon: '🏢', title: 'Trusted Organizations', desc: 'Get to know the organizations that are working to make safe water access a global reality.', link: 'Search organizations', href: '/explore/organizations' },
            { icon: '💬', title: 'Professional Consultants', desc: 'Speak with a certified consultant about your use case.', link: 'Talk to a consultant', href: '/learn/consultation' },
            { icon: '📚', title: 'Powerful Knowledge Base', desc: 'Dive into hundreds of peer-reviewed articles and white papers.', link: 'Start researching', href: '/learn/knowledge-hub' },
          ].map(({ icon, title, desc, link, href }) => (
            <div class="border border-gray-200 rounded-lg p-5 text-left hover:shadow-md transition-shadow">
              <div class="text-2xl mb-2">{icon}</div>
              <p class="font-bold text-[#1b3a6b] text-sm mb-1">{title}</p>
              <p class="text-gray-600 text-xs mb-3 leading-relaxed">{desc}</p>
              <a href={href} class="flex items-center gap-1 text-[#1d4ed8] text-xs font-semibold hover:underline">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                {link}
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Pillars of Water Resources hero strip -->
  <section class="bg-[#1b3a6b] text-white py-14">
    <div class="max-w-7xl mx-auto px-8 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-[#8dc63f] text-xs font-bold tracking-widest uppercase mb-3">Your pillars of water resources</p>
        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight mb-8">
          Providing access to the world's best-in-class products and pioneers for a more sustainable future
        </h2>
        <div class="space-y-6">
          {[
            { heading: 'Products & Solutions', body: 'Access valuable insights on hundreds of safe drinking water technologies through our solutions database.' },
            { heading: 'Organizations', body: 'A powerful resource connecting NGOs, IGOs, businesses, and change-makers working to improve safe water access worldwide. Easily search and filter by region, organization type, and focus areas to find partners that align with your mission.' },
            { heading: 'Knowledge Base', body: 'Visit our Knowledge Hub for access to an ever growing library of resources designed to deepen our collective understanding and increase our efficiencies in delivering safe drinking water.' },
            { heading: 'Consultation', body: 'Connect with a global network of water experts and harness collective expertise to combat the water crisis.' },
          ].map(({ heading, body }) => (
            <div>
              <h3 class="font-bold text-sm mb-1">{heading}</h3>
              <p class="text-blue-200 text-sm leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-1 gap-6">
        <!-- Stats -->
        <div class="flex gap-8 bg-white/10 rounded-xl p-6">
          {[
            { num: '300+', label: 'Products & Solutions' },
            { num: '250', label: 'Global Organizations' },
            { num: '73k', label: 'Data Points Collected' },
          ].map(({ num, label }) => (
            <div class="text-center">
              <p class="text-[#8dc63f] font-extrabold text-3xl">{num}</p>
              <p class="text-blue-200 text-xs mt-1">{label}</p>
            </div>
          ))}
        </div>
        <!-- Image placeholder -->
        <div class="bg-white/10 rounded-xl aspect-video flex items-center justify-center">
          <div class="text-center">
            <svg class="w-16 h-16 mx-auto text-[#8dc63f] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <p class="text-blue-200 text-sm">Water Access Solutions</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product category cards -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-7xl mx-auto px-8">
      <h2 class="text-[#1b3a6b] font-extrabold text-2xl mb-8 text-center">Products people love from brands that make a difference</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { title: 'Water Filtration', color: 'from-blue-800 to-blue-600', href: '/shop?cat=filtration' },
          { title: 'Water Treatment', color: 'from-teal-700 to-teal-500', href: '/shop?cat=treatment' },
          { title: 'Health & Hygiene', color: 'from-green-700 to-green-500', href: '/shop?cat=hygiene' },
        ].map(({ title, color, href }) => (
          <a href={href} class="group relative rounded-xl overflow-hidden aspect-video flex items-end hover:shadow-xl transition-shadow">
            <div class={`absolute inset-0 bg-gradient-to-br ${color} opacity-90`}></div>
            <div class="relative p-6 text-white w-full">
              <h3 class="font-extrabold text-lg">{title}</h3>
              <span class="text-sm opacity-80 group-hover:opacity-100 transition-opacity">Shop now →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog strip -->
  <section class="bg-white py-14">
    <div class="max-w-7xl mx-auto px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-[#1b3a6b] font-extrabold text-2xl">Stay up-to-date on the latest in global health victory</h2>
        <a href="/blog" class="text-[#1d4ed8] text-sm font-semibold hover:underline hidden md:block">View all articles →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { title: 'Water-Energy Nexus: Lessons from Zambia', date: 'February 9, 2025', tag: 'Knowledge', href: '/blog/water-energy-nexus-zambia', color: 'from-blue-800 to-blue-600' },
          { title: 'From Science to Global Impact: An Interview with Njapowa', date: 'January 6, 2025', tag: 'Knowledge', href: '/blog/science-to-global-impact', color: 'from-gray-600 to-gray-400' },
          { title: 'Your Healthiest New Year Starts with Smarter Hydration', date: 'January 6, 2025', tag: 'Knowledge', href: '/blog/healthy-new-year-hydration', color: 'from-teal-700 to-teal-500' },
        ].map(({ title, date, tag, href, color }) => (
          <a href={href} class="group rounded-xl overflow-hidden border border-gray-200 hover:shadow-lg transition-shadow block">
            <div class={`h-40 bg-gradient-to-br ${color} flex items-end p-4`}>
              <span class="text-white text-xs font-bold uppercase bg-white/20 px-2 py-0.5 rounded">{tag}</span>
            </div>
            <div class="p-5">
              <p class="text-gray-500 text-xs mb-2">{date}</p>
              <h3 class="font-bold text-[#1b3a6b] text-sm leading-snug group-hover:underline">{title}</h3>
              <span class="text-[#1d4ed8] text-xs mt-2 block font-semibold">Continue Reading →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="bg-gray-50 border-t border-gray-200 py-14">
    <div class="max-w-xl mx-auto px-8 text-center">
      <h2 class="text-[#1b3a6b] font-extrabold text-2xl mb-2">Want to know more? Get in touch!</h2>
      <p class="text-gray-500 text-sm mb-6">Join our newsletter and stay updated on global water and hygiene solutions.</p>
      <a href="/connect/contact" class="inline-block bg-[#1b3a6b] text-white font-bold px-8 py-3 rounded hover:bg-[#152d52] transition-colors text-sm">
        Contact Us
      </a>
    </div>
  </section>

</Layout>
