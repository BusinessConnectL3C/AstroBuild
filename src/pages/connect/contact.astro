---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact Us — Business Connect World">

  <section class="bg-gradient-to-br from-[#1b3a6b] to-[#2d5a9e] text-white py-16">
    <div class="max-w-7xl mx-auto px-8 text-center">
      <p class="text-[#8dc63f] text-xs font-bold tracking-widest uppercase mb-3">Get In Touch</p>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight">Send us a message</h1>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-5xl mx-auto px-8 grid md:grid-cols-2 gap-12">

      <!-- Contact info -->
      <div>
        <h2 class="text-[#1b3a6b] font-extrabold text-2xl mb-6">Contact Information</h2>
        <ul class="space-y-4 mb-8">
          <li class="flex items-center gap-3 text-gray-700">
            <div class="w-10 h-10 rounded-full bg-[#1b3a6b] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <span>1-833-229-6753</span>
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <div class="w-10 h-10 rounded-full bg-[#1b3a6b] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <span>contact@businessconnectworld.com</span>
          </li>
          <li class="flex items-start gap-3 text-gray-700">
            <div class="w-10 h-10 rounded-full bg-[#1b3a6b] flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <p>4064 Division Ave S</p>
              <p>Grand Rapids, MI 49548</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Form -->
      <div>
        <h2 class="text-[#1b3a6b] font-extrabold text-2xl mb-6">Send a Message</h2>
        <form class="space-y-4" onsubmit="return false;">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">First Name</label>
              <input type="text" class="w-full border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#8dc63f]" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Last Name</label>
              <input type="text" class="w-full border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#8dc63f]" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
            <input type="email" class="w-full border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#8dc63f]" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Organization</label>
            <input type="text" class="w-full border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#8dc63f]" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Message</label>
            <textarea rows="5" class="w-full border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#8dc63f] resize-none"></textarea>
          </div>
          <button type="submit" class="w-full bg-[#1b3a6b] text-white font-bold py-3 rounded hover:bg-[#152d52] transition-colors text-sm">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>

</Layout>
